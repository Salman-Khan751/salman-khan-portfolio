# Public site URL (used for canonical links, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://salmankhan-portfolio.vercel.app

# Optional: a GitHub personal access token (no scopes needed) raises the
# GitHub API limit for the "Live from GitHub" section from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Optional: deliver contact-form messages from the server via Resend (https://resend.com).
# Leave empty to keep the "open my email app" behavior.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
